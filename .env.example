TELEGRAM_BOT_TOKEN=
OPENAI_API_KEY=
VITALY_USER_ID=
# ASSISTANT_USER_ID — опционально. Если задан, этот человек добавляется как
# исполнитель «по умолчанию» при старте. Несколько исполнителей добавляются
# в боте командой /add_executor <id> <имя>, env для них не нужен.
ASSISTANT_USER_ID=
DB_PATH=./data/bot.db
TZ=Europe/Kyiv

# Година (0-23) ранкового дайджесту задач власнику
MORNING_DIGEST_HOUR=9
# Година (0-23) вечірнього дайджесту (виконане сьогодні + задачі на завтра)
EVENING_DIGEST_HOUR=19
# Через сколько часов спрашивать исполнителя о статусе, если напоминания не заданы голосом
FOLLOWUP_DELAY_HOURS=24

# Google Calendar (optional — leave empty for prototype mode)
GOOGLE_CALENDAR_ID=
GOOGLE_CREDENTIALS_PATH=
GOOGLE_TOKEN_PATH=
